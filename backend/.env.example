# ==============================================================================
# PROPCARE NW — FASTAPI BACKEND CONFIGURATION
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=true

# MongoDB Atlas Database Configuration
# Replace with your actual MongoDB Atlas connection string:
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=propcare_nw

# Security & Authentication (JWT + Argon2)
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Object Storage Configuration
# Options: 'local' (development), 'cloudinary', 's3'
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_SIGNING_SECRET=propcare_nw_secure_storage_token_key_2026

# Cloudinary Settings (Optional if STORAGE_PROVIDER=cloudinary)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Open-Meteo Weather API
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Frontend Integration & CORS
FRONTEND_URL=http://localhost:3000
